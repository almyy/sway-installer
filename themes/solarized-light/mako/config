# mako config — Solarized Light theme

font=JetBrains Mono 11
background-color=#eee8d5ee
text-color=#586e75
border-color=#268bd2
border-radius=6
border-size=1
width=320
height=100
margin=8
padding=10
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right

[urgency=low]
