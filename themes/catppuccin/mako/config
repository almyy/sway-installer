# mako config — Catppuccin Mocha theme

font=JetBrains Mono 11
background-color=#313244ee
text-color=#cdd6f4
border-color=#cba6f7
border-radius=6
border-size=1
width=320
height=100
margin=8
padding=10
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right

